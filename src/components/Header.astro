---
import { SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];

const trim = (path: string) => (path.length > 1 ? path.replace(/\/+$/, '') : path);
const current = trim(Astro.url.pathname);

// Exact match is the current page; a parent section (Blog on a post) is marked too
const ariaCurrent = (href: string) => {
  const target = trim(href);
  if (current === target) return 'page';
  if (target !== '/' && current.startsWith(`${target}/`)) return 'true';
  return undefined;
};
---

<header class="site-header hang">
  <a class="brand hang__margin" href="/">{SITE.title}</a>
  <div class="bar">
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={ariaCurrent(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    padding-top: clamp(1.25rem, 4vw, 2.25rem);
    align-items: center;
    row-gap: 0.75rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    justify-self: start;
  }

  @media (min-width: 60em) {
    .brand {
      justify-self: end;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--step--1);
  }

  nav a {
    display: inline-block;
    position: relative;
    padding-block: 0.375rem;
    color: var(--muted);
    text-decoration: none;
  }

  /* Invisible hit-area extension so the small links meet the ~44px touch guideline */
  nav a::after {
    content: '';
    position: absolute;
    inset: -0.5rem -1rem;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current] {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.45em;
  }
</style>
