<button type="button" class="theme-toggle" aria-label="Dark theme" aria-pressed="false">
  <svg class="icon icon--moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg class="icon icon--sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const stored = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
      button.setAttribute('aria-pressed', String(dark));
    });
  };

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable: the choice lasts for this page view */
      }
      sync();
    });
  });

  // Follow the system until the reader makes an explicit choice
  media.addEventListener('change', (event) => {
    if (stored()) return;
    root.dataset.theme = event.matches ? 'dark' : 'light';
    sync();
  });

  sync();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .icon {
    grid-area: 1 / 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the theme the button switches to */
  .icon--sun,
  :global([data-theme='dark']) .icon--moon {
    display: none;
  }

  :global([data-theme='dark']) .icon--sun {
    display: block;
  }

  /* Without JS there is nothing to toggle */
  :global(html:not([data-theme])) .theme-toggle {
    display: none;
  }
</style>
