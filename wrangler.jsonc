// Cloudflare Workers (static assets) configuration
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "untagged-blog",
  "compatibility_date": "2026-10-17",
  // staging/preview URLs: the workers.dev route is now OFF (the custom domain
  // untagged.dev is attached and is the single public origin). Preview URLs for
  // non-default branches stay enabled for PR-based experiments.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // serves dist/404.html for unknown routes
    "not_found_handling": "404-page",
    // /blog/<slug> and /blog/<slug>/ both work
    "html_handling": "auto-trailing-slash"
  }
}
